# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code: share project settings/hooks; ignore local settings + installed skills
/.claude/*
!/.claude/settings.json

# local agent / tooling scaffolding (python env, installed skill artifacts)
/.venv/
/.agents/
/skills-lock.json

# graphify: the graph + report are committed for the team, but local cache,
# dated backups, API-cost tracking, and the machine-specific python path are not
/graphify-out/cache/
/graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
/graphify-out/cost.json
/graphify-out/.graphify_python
